{
  "name": "@otmetki/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client for the Three Marks public API (/v1), generated from its OpenAPI spec, with API-key, base-URL and retry handling and a Standard Webhooks verifier.",
  "homepage": "https://triotmetki.ru",
  "bugs": {
    "url": "https://github.com/Zilero232/Triotmetki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/Triotmetki.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "author": "Alexandr Artemev",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "src/index.ts",
  "scripts": {
    "postinstall": "openapi-ts",
    "sdk:build": "openapi-ts",
    "sdk:generate": "bun --filter @otmetki/server openapi:export && prettier --write openapi/v1.json && openapi-ts",
    "sdk:generate:live": "openapi-ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ky": "catalog:",
    "standardwebhooks": "catalog:"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "catalog:",
    "typescript": "catalog:"
  }
}
