# Copy to .env at the repo root; shared by every app. Secrets: openssl rand -base64 32

NODE_ENV=development

# debug | info …, json | pretty (defaults depend on NODE_ENV)
# LOG_LEVEL=
# LOG_FORMAT=


# ── Client ──────────────────────────────────────────────

# Public, baked into the bundle
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# «Lesta data is not connected yet» notice
LESTA_NOTICE=true


# ── Server ──────────────────────────────────────────────

PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Comma-separated
CORS_ORIGINS=
TRUSTED_PROXIES=


# ── Database and Redis ──────────────────────────────────

DATABASE_URL=postgresql://otmetki:otmetki@localhost:5434/otmetki
DIRECT_URL=postgresql://otmetki:otmetki@localhost:5434/otmetki
# DATABASE_POOL_MAX=

REDIS_URL=redis://localhost:6380


# ── Secrets (32+ chars) ─────────────────────────────────

BETTER_AUTH_SECRET=dev-secret-change-me-min-32-chars-000
TOKEN_ENCRYPTION_SECRET=dev-secret-change-me-token-encryption-000
MOD_INGEST_SECRET=dev-mod-secret-change-me-min-32-chars-000

# Next server → API; required by both
INTERNAL_API_TOKEN=


# ── Lesta API ───────────────────────────────────────────

# Empty = no Lesta (degraded worker, no Lesta ID sign-in)
LESTA_APPLICATION_ID=
LESTA_RPS=20

# Up to 5 registered IPs; this process's one must be in the list
LESTA_EGRESS_IPS=
LESTA_EGRESS_IP=


# ── Tools ───────────────────────────────────────────────

# /admin/queues, user admin; empty = off
BULL_BOARD_PASSWORD=

# Higher GitHub API limit for gamedata:import
GITHUB_TOKEN=


# ── Telegram ────────────────────────────────────────────

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Empty = long polling (dev)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=


# ── Discord ─────────────────────────────────────────────

DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=


# ── VK ──────────────────────────────────────────────────

VK_BOT_TOKEN=
VK_GROUP_ID=

# Empty = Bots Long Poll (dev)
VK_CALLBACK_CONFIRMATION=
VK_CALLBACK_SECRET=

VK_MINI_APP_ID=
VK_MINI_APP_SECRET=

VK_ID_CLIENT_ID=
VK_ID_CLIENT_SECRET=


# ── Notifications ───────────────────────────────────────

# bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@triotmetki.ru

# Dev: Mailpit, inbox http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev
SMTP_PASSWORD=dev
EMAIL_FROM="Три отметки <noreply@triotmetki.ru>"


# ── Payments ────────────────────────────────────────────

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RECURRING=false


# ── Streamers ───────────────────────────────────────────

DONATIONALERTS_CLIENT_ID=
DONATIONALERTS_CLIENT_SECRET=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

VK_LIVE_CLIENT_ID=
VK_LIVE_CLIENT_SECRET=

YOUTUBE_API_KEY=


# ── Production compose ──────────────────────────────────

# SITE_DOMAIN=triotmetki.ru
# API_DOMAIN=api.triotmetki.ru

# POSTGRES_USER=otmetki
# POSTGRES_PASSWORD=
# POSTGRES_DB=otmetki


# ── Build and e2e ───────────────────────────────────────

# GIT_COMMIT_SHA=
# OTMETKI_OPENAPI_URL=

# E2E_BASE_URL=http://localhost:3000
# E2E_API_URL=http://localhost:4000
# E2E_AUTH_STATE=
# E2E_SCREENS_WORKERS=
