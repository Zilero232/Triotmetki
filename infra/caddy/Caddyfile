# `?` only fills headers the apps left unset (overlays and the Mini App are frameable).
(security_headers) {
	header {
		?X-Content-Type-Options nosniff
		?X-Frame-Options DENY
		?Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Drop tokens from logged query strings and every credential header (Caddy redacts only cookies and Authorization).
(access_log) {
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers>X-Otmetki-Internal-Token delete
				request>headers>X-Api-Key delete
				request>headers>X-Telegram-Bot-Api-Secret-Token delete
				request>headers>X-Otmetki-Device delete
				request>headers>X-Otmetki-Signature delete
				request>headers>Referer delete
				resp_headers>Set-Auth-Token delete
				request>uri query {
					delete access_token
					delete token
					delete code
					delete state
				}
			}
		}
	}
}

# DEPLOY_PATH/downloads, read-only, no listing; versioned folders are immutable.
(downloads) {
	root * /srv
	file_server

	@exe path *.exe
	header @exe {
		Content-Type application/vnd.microsoft.portable-executable
		Content-Disposition attachment
	}

	@mtmod path *.mtmod
	header @mtmod {
		Content-Type application/zip
		Content-Disposition attachment
	}

	@json path *.json
	header @json Content-Type "application/json; charset=utf-8"

	@sig path *.sig
	header @sig Content-Type "text/plain; charset=utf-8"

	@png path *.png
	header @png Content-Type image/png

	@webp path *.webp
	header @webp Content-Type image/webp

	@mp3 path *.mp3
	header @mp3 Content-Type audio/mpeg

	@mp4 path *.mp4
	header @mp4 Content-Type video/mp4

	@versioned path /downloads/modpack/* /downloads/manager/*
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	@current path /downloads/releases.json /downloads/otmetki-manager-setup.exe /downloads/otmetki.mtmod
	header @current Cache-Control no-cache
}

{$API_DOMAIN} {
	# SSE would be buffered by the encoder.
	@compressible not path_regexp ^/overlays/[^/]+/stream$
	encode @compressible zstd gzip

	# bull-board only over an ssh tunnel; the rest of /admin is the role-guarded API.
	respond /admin/queues* 404

	# REPLAY_UPLOAD.maxBytes (50 MiB) plus the multipart envelope; the server checks again.
	request_body /replays* {
		max_size 51MiB
	}

	reverse_proxy server:4000 {
		# Keep WebSocket and SSE streams open across a config reload.
		stream_close_delay 5m
	}

	import security_headers
	import access_log
}

{$SITE_DOMAIN} {
	encode zstd gzip

	handle /downloads/* {
		import downloads
	}

	handle {
		reverse_proxy client:3000
	}

	# Hashed assets never change under the same name.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# The browser must revalidate the service worker on every check; Next marks the prerendered file s-maxage.
	@serviceWorker path /serwist/*
	header @serviceWorker >Cache-Control no-cache

	import security_headers
	import access_log
}
