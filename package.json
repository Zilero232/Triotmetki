{
  "name": "otmetki",
  "version": "0.1.1",
  "private": true,
  "description": "Three Marks (triotmetki.ru): the companion platform for Mir Tankov (Lesta, RU realm), with the site, the API and collector, the game modpack and its manager in one Bun-workspaces monorepo.",
  "homepage": "https://triotmetki.ru",
  "bugs": {
    "url": "https://github.com/Zilero232/Triotmetki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/Triotmetki.git"
  },
  "license": "UNLICENSED",
  "author": "Alexandr Artemev",
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/game/*",
      "apps/web/*",
      "packages/*"
    ],
    "catalog": {
      "@base-ui/react": "^1.8.0",
      "@date-fns/tz": "^1.5.0",
      "@hey-api/openapi-ts": "0.99.0",
      "@hookform/resolvers": "^5.9.1",
      "@mdxeditor/editor": "^4.3.1",
      "@resvg/resvg-js": "2.6.2",
      "@siberiacancode/reactuse": "^1.0.17",
      "@stefanprobst/rehype-extract-toc": "^3.0.0",
      "@tanstack/react-query": "^5.103.2",
      "@testing-library/react": "^16.3.3",
      "@types/bun": "^1.4.2",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "better-auth": "^1.7.5",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "date-fns": "^4.4.0",
      "esbuild": "^0.28.2",
      "feed": "^6.0.0",
      "file-type": "^22.1.1",
      "ky": "^2.1.0",
      "lucide-react": "^1.48.0",
      "motion": "^13.4.3",
      "pino-pretty": "^13.1.3",
      "pure-rand": "^8.4.2",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "react-hook-form": "^7.88.0",
      "reading-time": "^1.5.0",
      "rehype-autolink-headings": "^7.1.0",
      "rehype-sanitize": "^6.0.0",
      "rehype-slug": "^6.0.0",
      "remark-gfm": "^4.0.1",
      "remark-parse": "^11.0.0",
      "remark-rehype": "^11.1.2",
      "remeda": "^2.50.0",
      "sass-embedded": "^1.105.0",
      "sonner": "^2.0.8",
      "standardwebhooks": "^1.1.1",
      "ts-pattern": "^5.9.0",
      "typescript": "~6.0.3",
      "unified": "^11.0.5",
      "vfile": "^6.0.3",
      "y-protocols": "1.0.7",
      "yjs": "13.6.33",
      "zod": "^4.6.5"
    }
  },
  "scripts": {
    "build": "bun --filter @otmetki/client build",
    "db:push": "bun --filter @otmetki/server db:push",
    "db:reset": "bun --filter @otmetki/server db:reset",
    "db:studio": "bun --filter @otmetki/server db:studio",
    "dev": "concurrently -n server,client -c blue,green --restart-tries 20 --restart-after 3000 \"bun run dev:server\" \"bun run dev:client\"",
    "dev:all": "concurrently -n server,worker,client -c blue,magenta,green --restart-tries 20 --restart-after 3000 \"bun run dev:server\" \"bun run dev:worker\" \"bun run dev:client\"",
    "dev:client": "bun --filter @otmetki/client dev",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:manager": "bun --filter @otmetki/manager dev",
    "dev:modpack": "bun --filter @otmetki/modpack dev:watch",
    "dev:server": "bun --filter @otmetki/server dev",
    "dev:worker": "bun --filter @otmetki/server dev:worker",
    "e2e:screens": "playwright test -c playwright.screens.config.ts",
    "fix": "bun run lint:fix && bun run format && bun run lint:css:fix && bun --filter @otmetki/server format:prisma",
    "format": "prettier --write . --cache",
    "format:check": "prettier --check . --cache",
    "gamedata:import": "bun --filter @otmetki/server gamedata:import",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/.eslintcache",
    "lint:css": "stylelint \"{apps/web/client,apps/game/modpack/ui-web,apps/game/manager/web,packages/design-tokens}/**/*.scss\" --cache --cache-strategy content --cache-location node_modules/.cache/.stylelintcache",
    "lint:css:fix": "stylelint \"{apps/web/client,apps/game/modpack/ui-web,apps/game/manager/web,packages/design-tokens}/**/*.scss\" --fix --cache --cache-strategy content --cache-location node_modules/.cache/.stylelintcache",
    "lint:cycles": "bun --filter @otmetki/client lint:cycles",
    "lint:dupes": "jscpd",
    "lint:encoding": "node scripts/check-utf8.mjs",
    "lint:fix": "eslint . --fix --cache --cache-strategy content --cache-location node_modules/.cache/.eslintcache",
    "lint:unused": "knip",
    "prepare": "husky",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config apps/web/server/vitest.db.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:modpack": "bun --filter @otmetki/modpack test",
    "typecheck": "bun --filter '*' typecheck",
    "verify": "bun run typecheck && bun run lint && bun run lint:cycles && bun run lint:encoding && bun run format:check && bun run lint:css"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix --cache --cache-strategy content --cache-location node_modules/.cache/.eslintcache",
      "prettier --write"
    ],
    "**/package.json": [
      "sort-package-json"
    ],
    "*.{json,md,yml,yaml}": "prettier --write",
    "{apps/web/client,apps/game/modpack/ui-web,apps/game/manager/web,packages/design-tokens}/**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "kysely": "0.29.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@siberiacancode/eslint": "^2.18.1",
    "@siberiacancode/prettier": "^1.9.0",
    "@siberiacancode/stylelint": "^1.2.0",
    "@siberiacancode/tsconfig": "^1.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "fkill-cli": "^9.0.0",
    "husky": "^9.1.7",
    "jscpd": "^5.3.2",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.8",
    "sort-package-json": "^4.0.0",
    "stylelint": "17.15.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "catalog:",
    "vitest": "^5.0.2"
  }
}
