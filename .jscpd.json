{
  "threshold": 2,
  "minTokens": 60,
  "minLines": 8,
  "reporters": ["console"],
  "format": ["typescript", "tsx", "javascript", "scss", "python"],
  "path": ["apps", "packages", "e2e"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.next-*/**",
    "**/dist/**",
    "**/generated/**",
    "**/coverage/**",
    "**/.cache/**",
    "**/__pycache__/**",
    "**/_tests/**",
    "**/tests/**",
    "**/*.test.{ts,tsx}",
    "**/*.d.ts",
    "**/index.ts",
    "**/shared/i18n/locales/**",
    "**/shared/api/openapi/**",
    "**/sdk/openapi/**",
    "**/vendor/**",
    "**/fixtures/**",
    "**/*.fixtures.ts"
  ],
  "gitignore": true,
  "absolute": false
}
