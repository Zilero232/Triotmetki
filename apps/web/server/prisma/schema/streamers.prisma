enum OverlayKind {
  session
  wn8
  moe
  damage
  winRate   @map("win_rate")
  winStreak @map("win_streak")
  challenge
  custom

  @@map("overlay_kind")
}

enum ChallengeStatus {
  pending
  active
  succeeded
  failed
  cancelled
  expired
  refunded

  @@map("challenge_status")
}

enum StreamerProvider {
  donationAlerts @map("donation_alerts")
  twitch
  vkPlayLive     @map("vk_play_live")
  youtube

  @@map("streamer_provider")
}

enum StreamerProfileKind {
  claimed
  editorial

  @@map("streamer_profile_kind")
}

enum StreamerPlatform {
  twitch
  vkVideoLive @map("vk_video_live")
  youtube
  trovo
  telegram
  boosty
  vk

  @@map("streamer_platform")
}

enum StreamerClaimMethod {
  oauth
  bioCode @map("bio_code")
  manual

  @@map("streamer_claim_method")
}

enum StreamerSettingsSource {
  creator
  editorial
  mod
  preferences

  @@map("streamer_settings_source")
}

enum SettingsApplyStatus {
  pending
  applied
  rejected
  expired

  @@map("settings_apply_status")
}

enum StreamerInvitationStatus {
  pending
  sent
  accepted
  declined

  @@map("streamer_invitation_status")
}

model StreamerProfile {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId            String?             @unique @map("user_id")
  kind              StreamerProfileKind @default(claimed)
  slug              String              @unique
  displayName       String              @map("display_name")
  accountId         BigInt?             @map("account_id")
  accountSourceUrl  String?             @map("account_source_url")
  bio               String?
  links             Json?
  settings          Json?
  settingsUpdatedAt DateTime?           @map("settings_updated_at") @db.Timestamptz(3)

  isLive        Boolean           @default(false) @map("is_live")
  liveTankId    Int?              @map("live_tank_id")
  liveViewers   Int?              @map("live_viewers")
  livePlatform  StreamerPlatform? @map("live_platform")
  liveStartedAt DateTime?         @map("live_started_at") @db.Timestamptz(3)
  liveCheckedAt DateTime?         @map("live_checked_at") @db.Timestamptz(3)
  hiddenAt      DateTime?         @map("hidden_at") @db.Timestamptz(3)
  mergedIntoId  String?           @map("merged_into_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channels StreamerChannel[]
  versions StreamerSettingsVersion[]
  claims   StreamerClaim[]
  follows  StreamerFollow[]
  applies  SettingsApplyRequest[]

  @@index([kind, isLive])
  @@index([accountId])
  @@map("streamer_profile")
}

model StreamerChannel {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  profileId  String           @map("profile_id")
  platform   StreamerPlatform
  handle     String
  url        String
  externalId String?          @map("external_id")
  verifiedAt DateTime?        @map("verified_at") @db.Timestamptz(3)
  sourceUrl  String?          @map("source_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile StreamerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([platform, handle])
  @@index([profileId])
  @@map("streamer_channel")
}

model StreamerClaim {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  profileId    String?             @map("profile_id")
  invitationId String?             @map("invitation_id")
  userId       String              @map("user_id")
  method       StreamerClaimMethod
  platform     StreamerPlatform?
  code         String?
  status       ReportStatus        @default(open)
  evidence     String?
  resolvedBy   String?             @map("resolved_by")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  profile    StreamerProfile?    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  invitation StreamerInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("streamer_claim")
}

model StreamerInvitation {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  slug        String                   @unique
  displayName String                   @map("display_name")
  channels    Json
  sourceUrl   String?                  @map("source_url")
  status      StreamerInvitationStatus @default(pending)
  sentAt      DateTime?                @map("sent_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  claims StreamerClaim[]

  @@map("streamer_invitation")
}

model StreamerSettingsVersion {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  profileId     String                 @map("profile_id")
  data          Json
  source        StreamerSettingsSource
  changedGroups String[]               @map("changed_groups")
  createdBy     String?                @map("created_by")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  profile StreamerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt(sort: Desc)])
  @@map("streamer_settings_version")
}

model PlayerSettingsShare {
  userId String @id @map("user_id")

  accountId      BigInt? @map("account_id")
  data           Json
  anonymousStats Boolean @default(false) @map("anonymous_stats")

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([anonymousStats])
  @@map("player_settings_share")
}

model SettingsApplyRequest {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId    String              @map("user_id")
  deviceId  String?             @map("device_id")
  profileId String              @map("profile_id")
  groups    String[]
  data      Json
  status    SettingsApplyStatus @default(pending)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  appliedAt DateTime? @map("applied_at") @db.Timestamptz(3)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile StreamerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
  @@map("settings_apply_request")
}

model StreamerFollow {
  userId    String @map("user_id")
  profileId String @map("profile_id")

  tankId       Int?     @map("tank_id")
  lastAlertKey String?  @map("last_alert_key")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile StreamerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([userId, profileId])
  @@index([profileId])
  @@map("streamer_follow")
}

model SettingsAggregate {
  cohort String
  field  String
  bucket String

  count        Int
  contributors Int
  median       Float?
  computedAt   DateTime @map("computed_at") @db.Timestamptz(3)

  @@id([cohort, field, bucket])
  @@map("settings_aggregate")
}

model StreamerIntegration {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId     String           @map("user_id")
  provider   StreamerProvider
  externalId String           @map("external_id")

  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(3)
  scope          String?
  config         Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@unique([userId, provider])
  @@map("streamer_integration")
}

model Overlay {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  userId    String      @map("user_id")
  accountId BigInt?     @map("account_id")
  name      String
  kind      OverlayKind
  theme     String      @default("steel")
  config    Json
  publicKey String      @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)")) @map("public_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("overlay")
}

model Challenge {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  streamerUserId String          @map("streamer_user_id")
  accountId      BigInt          @map("account_id")
  code           String
  title          String
  condition      Json
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("RUB")
  status         ChallengeStatus @default(pending)

  donorName          String?           @map("donor_name")
  donorMessage       String?           @map("donor_message")
  donationSource     StreamerProvider? @map("donation_source")
  donationExternalId String?           @map("donation_external_id")

  battleId   String?   @map("battle_id")
  progress   Json?
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  streamer User @relation(fields: [streamerUserId], references: [id], onDelete: Cascade)

  @@unique([donationSource, donationExternalId])
  @@unique([streamerUserId, code])
  @@index([streamerUserId, status])
  @@index([accountId, status])
  @@map("challenge")
}
