enum RatingPeriod {
  overall
  h24     @map("24h")
  d7      @map("7d")
  d30     @map("30d")
  d60     @map("60d")
  b1000   @map("1000b")

  @@map("rating_period")
}

enum ServerStatsPeriod {
  d1  @map("1d")
  d7  @map("7d")
  d14 @map("14d")
  d30 @map("30d")
  d60 @map("60d")

  @@map("server_stats_period")
}

enum CohortFilter {
  all
  beginner
  average
  good
  elite

  @@map("cohort_filter")
}

enum PercentileDistribution {
  damage
  xp
  bronya

  @@map("percentile_distribution")
}

view TankDailyStats {
  day    DateTime    @db.Timestamptz(3)
  tankId Int         @map("tank_id")
  mode   StatsMode
  cohort SkillCohort

  samples            BigInt
  battles            BigInt
  wins               BigInt
  damageDealt        BigInt @map("damage_dealt")
  damageBlocked      BigInt @map("damage_blocked")
  frags              BigInt
  spotted            BigInt
  xp                 BigInt
  survived           BigInt @map("survived_battles")
  hits               BigInt
  shots              BigInt
  playerWinsWeighted Float  @map("player_wins_weighted")

  @@map("tank_daily_stats")
}

model TankServerStats {
  tankId Int               @map("tank_id")
  mode   StatsMode
  period ServerStatsPeriod
  cohort CohortFilter

  battles Int
  players Int
  samples Int @default(0)

  winRate        Float   @map("win_rate")
  playerWinRate  Float   @map("player_win_rate")
  winRateDiff    Float   @map("win_rate_diff")
  avgDamage      Float   @map("avg_damage")
  avgFrags       Float   @map("avg_frags")
  avgSpotted     Float   @map("avg_spotted")
  avgXp          Float   @map("avg_xp")
  avgBlocked     Float   @map("avg_blocked")
  survivalRate   Float   @map("survival_rate")
  accuracy       Float
  popularityRank Int?    @map("popularity_rank")
  tierListRank   String? @map("tier_list_rank")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  @@id([tankId, mode, period, cohort])
  @@index([mode, period, winRateDiff(sort: Desc)])
  @@map("tank_server_stats")
}

model AccountRating {
  accountId BigInt       @map("account_id")
  period    RatingPeriod

  battles    Int
  winRate    Float  @map("win_rate")
  avgDamage  Float  @map("avg_damage")
  avgFrags   Float  @map("avg_frags")
  avgTier    Float? @map("avg_tier")
  wn8        Float?
  eff        Float?
  broneIndex Float? @map("brone_index")

  fromCapturedAt DateTime? @map("from_captured_at") @db.Timestamptz(3)
  toCapturedAt   DateTime? @map("to_captured_at") @db.Timestamptz(3)
  computedAt     DateTime  @default(now()) @map("computed_at") @db.Timestamptz(3)

  player Player @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@id([accountId, period])
  @@index([period, wn8(sort: Desc)])
  @@index([period, broneIndex(sort: Desc)])
  @@index([period, eff(sort: Desc)])
  @@index([period, winRate(sort: Desc)])
  @@index([period, avgDamage(sort: Desc)])
  @@map("account_rating")
}

model AccountTankRating {
  accountId BigInt       @map("account_id")
  tankId    Int          @map("tank_id")
  period    RatingPeriod

  battles          Int
  winRate          Float  @map("win_rate")
  avgDamage        Float  @map("avg_damage")
  avgFrags         Float  @map("avg_frags")
  avgXp            Float  @map("avg_xp")
  wn8              Float?
  damagePercentile Float? @map("damage_percentile")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  player Player @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@id([accountId, tankId, period])
  @@index([tankId, period, wn8(sort: Desc)])
  @@index([tankId, period, avgDamage(sort: Desc)])
  @@map("account_tank_rating")
}

model Wn8ExpectedValue {
  tankId Int      @map("tank_id")
  date   DateTime @db.Date
  source String

  expDamage  Float @map("exp_damage")
  expFrags   Float @map("exp_frags")
  expSpotted Float @map("exp_spotted")
  expDefense Float @map("exp_defense")
  expWinRate Float @map("exp_win_rate")

  @@id([tankId, source, date])
  @@index([date])
  @@map("wn8_expected_value")
}

model TankPercentile {
  tankId       Int                    @map("tank_id")
  date         DateTime               @db.Date
  distribution PercentileDistribution

  percentiles Json

  @@id([tankId, distribution, date])
  @@index([date])
  @@map("tank_percentile")
}

enum EconomyAccount {
  all
  premium
  standard

  @@map("economy_account")
}

model TankEconomyAggregate {
  tankId  Int            @map("tank_id")
  account EconomyAccount

  battles     Int
  players     Int
  costBattles Int    @default(0) @map("cost_battles")
  credits     Float?
  creditsBase Float? @map("credits_base")
  repair      Float?
  ammo        Float?
  consumables Float?
  net         Float?
  xp          Float?
  freeXp      Float? @map("free_xp")
  windowDays  Int    @map("window_days")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  @@id([tankId, account])
  @@map("tank_economy_aggregate")
}

model TankLearningCurve {
  tankId Int @map("tank_id")
  bucket Int @db.SmallInt

  battles    Int
  players    Int
  wins       Int
  damage     BigInt
  windowDays Int    @map("window_days")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  @@id([tankId, bucket])
  @@map("tank_learning_curve")
}

enum BuildCohort {
  all
  top10
  top1

  @@map("build_cohort")
}

model BuildUsageAggregate {
  tankId      Int         @map("tank_id")
  mode        GameMode
  cohort      BuildCohort
  gameVersion String      @map("game_version")

  battles    Int
  players    Int
  winRate    Float? @map("win_rate")
  avgDamage  Float? @map("avg_damage")
  usage      Json
  windowDays Int    @map("window_days")

  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  @@id([tankId, mode, cohort, gameVersion])
  @@index([mode, cohort, computedAt(sort: Desc)])
  @@index([tankId, mode, cohort, computedAt(sort: Desc)])
  @@index([computedAt])
  @@map("build_usage_aggregate")
}
