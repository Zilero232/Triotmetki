enum ReportStatus {
  open
  resolved
  dismissed

  @@map("report_status")
}

enum DeletionSource {
  user
  lesta

  @@map("deletion_source")
}

enum DeletionStatus {
  pending
  processing
  completed
  failed
  superseded

  @@map("deletion_status")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  actorUserId String? @map("actor_user_id")
  action      String
  entityType  String  @map("entity_type")
  entityId    String? @map("entity_id")
  metadata    Json?
  ip          String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId])
  @@map("audit_log")
}

model ContentReport {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  reporterUserId String?      @map("reporter_user_id")
  targetType     String       @map("target_type")
  targetId       String       @map("target_id")
  reason         String
  details        String?
  status         ReportStatus @default(open)
  resolvedBy     String?      @map("resolved_by")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)

  reporter User? @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("content_report")
}

model DataDeletionRequest {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  accountId BigInt         @map("account_id")
  source    DeletionSource
  status    DeletionStatus @default(pending)
  reason    String?
  error     String?

  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)
  failedAt     DateTime? @map("failed_at") @db.Timestamptz(3)
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(3)

  @@index([status, requestedAt])
  @@index([accountId])
  @@map("data_deletion_request")
}

model CollectorJobMetric {
  queue       String
  bucketStart DateTime @map("bucket_start") @db.Timestamptz(3)

  processed       Int    @default(0)
  failed          Int    @default(0)
  retried         Int    @default(0)
  durationMsTotal BigInt @default(0) @map("duration_ms_total")
  lestaRequests   Int    @default(0) @map("lesta_requests")
  lestaErrors     Int    @default(0) @map("lesta_errors")
  lagSeconds      Int?   @map("lag_seconds")
  queueDepth      Int?   @map("queue_depth")

  @@id([queue, bucketStart])
  @@index([bucketStart(sort: Desc)])
  @@map("collector_job_metric")
}

model CollectorState {
  key String @id

  value Json

  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("collector_state")
}
