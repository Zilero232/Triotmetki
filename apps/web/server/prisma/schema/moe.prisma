enum ThresholdSource {
  otmetki
  poliroid
  kttc
  lesta
  manual

  @@map("threshold_source")
}

enum ThresholdKind {
  moe
  mastery

  @@map("threshold_kind")
}

model TankThreshold {
  kind   ThresholdKind
  tankId Int             @map("tank_id")
  date   DateTime        @db.Date
  source ThresholdSource

  level1 Int  @map("level_1")
  level2 Int  @map("level_2")
  level3 Int  @map("level_3")
  level4 Int? @map("level_4")

  sampleSize Int?     @map("sample_size")
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(3)

  @@id([kind, tankId, source, date])
  @@index([kind, date])
  @@index([date])
  @@map("tank_threshold")
}
