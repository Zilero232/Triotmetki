generator client {
  provider        = "prisma-client-js"
  output          = "../generated"
  previewFeatures = ["views"]
}

generator kysely {
  provider            = "prisma-kysely"
  output              = "../generated/kysely"
  fileName            = "database.ts"
  enumFileName        = "enums.ts"
  bigIntTypeOverride  = "number"
  decimalTypeOverride = "number"
}

datasource db {
  provider = "postgresql"
}
