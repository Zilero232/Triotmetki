{
  "name": "@otmetki/server",
  "version": "0.1.0",
  "private": true,
  "description": "Three Marks server — NestJS on Bun: the site API, auth (Lesta ID, Telegram, magic link), public /v1, the mod ingest and the collector worker that pulls the Lesta API into TimescaleDB.",
  "homepage": "https://triotmetki.ru",
  "bugs": {
    "url": "https://github.com/Zilero232/Triotmetki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/Triotmetki.git",
    "directory": "apps/web/server"
  },
  "license": "UNLICENSED",
  "author": "Alexandr Artemev",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "armor:purge": "bun --env-file=../../../.env scripts/armor-purge.ts",
    "db:deploy": "bun scripts/timescale.ts --extensions && prisma db push && bun run db:timescale",
    "db:generate": "prisma generate",
    "db:push": "bun scripts/timescale.ts --extensions && prisma db push && prisma generate && bun run db:timescale",
    "db:reset": "prisma db execute --file prisma/sql/reset.sql && bun scripts/timescale.ts --extensions && prisma db push && prisma generate && bun run db:timescale",
    "db:studio": "prisma studio",
    "db:timescale": "bun scripts/timescale.ts",
    "deletion:request": "bun --env-file=../../../.env scripts/deletion-request.ts",
    "predev": "fkill :4000 --force --silent",
    "dev": "nodemon --config nodemon.json",
    "dev:worker": "nodemon --config nodemon.json --exec \"bun --env-file ../../../.env src/worker.ts\"",
    "format:prisma": "prisma format",
    "gamedata:import": "bun --env-file=../../../.env scripts/gamedata-import.ts",
    "postinstall": "prisma generate",
    "openapi:export": "bun --env-file=../../../.env scripts/openapi-export.ts",
    "start": "bun src/main.ts",
    "start:worker": "bun src/worker.ts",
    "streamers:seed": "bun --env-file=../../../.env scripts/streamers-seed.ts",
    "typecheck": "tsc --noEmit"
  },
