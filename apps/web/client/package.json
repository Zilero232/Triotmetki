{
  "name": "@otmetki/client",
  "version": "0.1.0",
  "private": true,
  "description": "Three Marks website: a Next.js 16 / React 19 app in Feature-Sliced Design with next-intl (ru/en), SCSS modules and visx charts.",
  "homepage": "https://triotmetki.ru",
  "bugs": {
    "url": "https://github.com/Zilero232/Triotmetki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/Triotmetki.git",
    "directory": "apps/web/client"
  },
  "license": "UNLICENSED",
  "author": "Alexandr Artemev",
  "type": "module",
  "scripts": {
    "api:build": "openapi-ts",
    "api:generate": "bun --filter @otmetki/server openapi:export --doc internal && prettier --write shared/api/openapi/internal.json && openapi-ts",
    "build": "next build",
    "predev": "fkill :3000 --force --silent",
    "dev": "NODE_OPTIONS=--max-old-space-size=6144 next dev -p 3000",
    "lint:cycles": "bun config/import-cycles/check-import-cycles.ts",
    "panel:build": "bun config/panel-script/build-panel-script.ts",
    "start": "next start -p 3000",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.sw.json"
  },
