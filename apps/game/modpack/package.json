{
  "name": "@otmetki/modpack",
  "version": "0.3.8",
  "private": true,
  "description": "Three Marks game modpack for Mir Tankov: Python 2.7 .mtmod packages (core, companion, features), the Gameface UI pages and their Python 2.7 build, dev and test tooling.",
  "homepage": "https://triotmetki.ru",
  "bugs": {
    "url": "https://github.com/Zilero232/Triotmetki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/Triotmetki.git",
    "directory": "apps/game/modpack"
  },
  "license": "UNLICENSED",
  "author": "Alexandr Artemev",
  "type": "module",
  "scripts": {
    "build": "mise exec -- python tools/build/build.py",
    "build:catalog": "mise exec -- python tools/build/setupkit --packages dist",
    "build:release": "mise exec -- python tools/build/build.py --require-pyc",
    "dev:install": "mise exec -- python tools/dev install",
    "dev:log": "mise exec -- python tools/dev log",
    "dev:status": "mise exec -- python tools/dev status",
    "dev:uninstall": "mise exec -- python tools/dev uninstall",
    "dev:watch": "mise exec -- python tools/dev watch",
    "lint": "mise exec -- ruff check .",
    "test": "mise exec -- python tools/run_tests.py",
    "typecheck": "tsc -p ui-web --noEmit",
    "ui:build": "vite build -c ui-web/vite.config.ts --configLoader runner && vite build -c ui-web/vite.config.ts --configLoader runner --mode hud && vite build -c ui-web/vite.config.ts --configLoader runner --mode advisor && vite build -c ui-web/vite.config.ts --configLoader runner --mode viewer",
    "ui:dev": "vite -c ui-web/vite.config.ts --configLoader runner",
    "ui:test": "vitest run"
  },
  "dependencies": {
    "@nanostores/react": "^1.1.0",
    "@otmetki/icons": "workspace:*",
    "@siberiacancode/reactuse": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "nanostores": "1.5.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.6",
    "remeda": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@otmetki/design-tokens": "workspace:*",
    "@resvg/resvg-js": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/postcss-pxtorem": "^6.1.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "lucide-react": "catalog:",
    "postcss-color-functional-notation": "^8.0.15",
    "postcss-pxtorem": "^6.1.0",
    "sass-embedded": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "otmetki": {
    "games": [
      "1.45.*"
    ]
  }
}
