{
  "name": "@otmetki/modpack",
  "version": "0.2.2",
  "private": true,
  "description": "Три отметки modpack for «Мир танков»: Python 2.7 game-client packages (core, companion, features) built into .mtmod/.wotmod, with Python 3 host tooling (uv workspace, pytest, ruff).",
  "homepage": "https://triotmetki.ru",
  "bugs": {
    "url": "https://github.com/Zilero232/Triotmetki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/Triotmetki.git",
    "directory": "apps/game/modpack"
  },
  "license": "UNLICENSED",
  "author": "Alexandr Artemev",
  "type": "module",
  "scripts": {
    "build": "python tools/build/build.py",
    "build:catalog": "uv run python tools/build/setupkit --packages dist",
    "build:release": "python tools/build/build.py --require-pyc",
    "lint": "uv run ruff check .",
    "most:bundle": "uv run python tools/most --packages dist --release",
    "test": "python tools/run_tests.py",
    "test:pytest": "uv run pytest",
    "typecheck": "tsc -p ui-web --noEmit",
    "ui:build": "vite build -c ui-web/vite.config.ts --configLoader runner && vite build -c ui-web/vite.config.ts --configLoader runner --mode hud && vite build -c ui-web/vite.config.ts --configLoader runner --mode advisor && vite build -c ui-web/vite.config.ts --configLoader runner --mode viewer",
    "ui:dev": "vite -c ui-web/vite.config.ts --configLoader runner",
    "ui:test": "vitest run"
  },
  "dependencies": {
    "@nanostores/react": "^1.1.0",
    "@otmetki/icons": "workspace:*",
    "@siberiacancode/reactuse": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "nanostores": "1.5.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "remeda": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@otmetki/design-tokens": "workspace:*",
    "@resvg/resvg-js": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/postcss-pxtorem": "^6.1.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "lucide-react": "catalog:",
    "postcss-pxtorem": "^6.1.0",
    "sass-embedded": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "otmetki": {
    "games": [
      "1.45.*"
    ]
  }
}
