{
  "name": "@otmetki/manager",
  "version": "0.4.4",
  "private": true,
  "description": "Three Marks modpack manager: a Tauri 2 desktop app (Rust core, React UI) that installs the modpack, toggles components, keeps sets and profiles, and moves the modpack after a client patch.",
  "homepage": "https://triotmetki.ru",
  "bugs": {
    "url": "https://github.com/Zilero232/Triotmetki/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/Triotmetki.git",
    "directory": "apps/game/manager"
  },
  "license": "UNLICENSED",
  "author": "Alexandr Artemev",
  "type": "module",
  "scripts": {
    "build": "tauri build",
    "build:ui": "vite build --config web/vite.config.ts",
    "cargo:check": "cargo check --manifest-path tauri/Cargo.toml --all-targets",
    "cargo:clippy": "cargo clippy --manifest-path tauri/Cargo.toml --all-targets -- -D warnings",
    "cargo:test": "cargo test --manifest-path tauri/Cargo.toml",
    "dev": "bun scripts/dev-preflight.ts && tauri dev",
    "dev:free": "bun scripts/dev-preflight.ts",
    "dev:ui": "vite --config web/vite.config.ts",
    "tauri": "tauri",
    "typecheck": "tsc -p web --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "catalog:",
    "@otmetki/design-tokens": "workspace:*",
    "@otmetki/icons": "workspace:*",
    "@siberiacancode/reactuse": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-opener": "~2.6.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.13.0",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "remeda": "catalog:",
    "sonner": "catalog:",
    "ts-pattern": "catalog:",
    "use-intl": "^4.14.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "sass-embedded": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.1"
  }
}
