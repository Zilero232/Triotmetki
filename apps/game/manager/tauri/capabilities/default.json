{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: our own commands and events (file pickers open from Rust, so the webview never names a path), links (ours, videos, the runtime dependencies' authors and licences), self-update and restart.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://triotmetki.ru"
        },
        {
          "url": "https://triotmetki.ru/*"
        },
        {
          "url": "https://*.triotmetki.ru/*"
        },
        {
          "url": "https://youtube.com/*"
        },
        {
          "url": "https://www.youtube.com/*"
        },
        {
          "url": "https://youtu.be/*"
        },
        {
          "url": "https://rutube.ru/*"
        },
        {
          "url": "https://vk.com/*"
        },
        {
          "url": "https://vkvideo.ru/*"
        },
        {
          "url": "https://gitlab.com/openwg/*"
        },
        {
          "url": "https://gitlab.com/wot-public-mods/*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
