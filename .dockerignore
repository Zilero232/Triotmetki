# node_modules must never enter the build context: Bun installs them inside the
# image, and copying host node_modules over that install brings symlinks that
# point at a .bun store which does not exist in the image — every dependency
# then resolves to a broken symlink.
**/node_modules

# Build outputs and local state that have no business in an image.
**/.next
**/.next-*
**/out
**/dist
**/generated
**/coverage
**/.cache
**/.data
apps/web/server/downloads
**/*.tsbuildinfo
**/__pycache__
**/*.pyc
*.wotmod
*.mtmod

# The game modpack and the manager (a Tauri app; its Rust target/ alone runs to
# gigabytes) are built on the host or in their own workflows, never in an image.
# Only their package.json goes in: the bun workspace list must match bun.lock for --frozen-lockfile.
apps/game/modpack/*
!apps/game/modpack/package.json
apps/game/manager/*
!apps/game/manager/package.json

# Secrets and local env — images get their config at runtime, never baked in.
.env
.env.*
**/.env
**/.env.*

# Compose files and the Caddyfile live on the host; compose bind-mounts the
# Caddyfile, so no image needs infra/.
docker-compose*.yml
infra

# Tests, docs, local tooling and VCS noise.
e2e
playwright-report
scripts
docs
*.md
.git
.github
.husky
.vscode
.idea
.claude
.agents
**/*.log
